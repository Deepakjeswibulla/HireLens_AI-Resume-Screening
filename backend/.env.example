# Copy to .env (or export these) before starting uvicorn.
# All values are optional; the defaults are shown.

# Any SQLAlchemy URL. Default: sqlite:///<backend>/hirelens.db
HIRELENS_DATABASE_URL=sqlite:///./hirelens.db

# Private directory for uploaded resumes. Default: <backend>/data/uploads
HIRELENS_UPLOAD_DIR=./data/uploads

# Upload limits
HIRELENS_MAX_UPLOAD_MB=10
HIRELENS_MAX_RESUMES=60

# Embedding model (downloaded on first use, ~90 MB)
HIRELENS_SEMANTIC_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Set to 1 to skip the transformer model entirely and use the TF-IDF/SVD fallback
HIRELENS_DISABLE_MODEL=0

# INFO | WARNING | DEBUG
HIRELENS_LOG_LEVEL=INFO
