# Copy to .env.local to override the API base URL.
# Default: /api, which Vite proxies to http://localhost:8000 during dev and preview.
# For a separately hosted backend use the full URL, e.g.:
# VITE_API_URL=http://localhost:8000/api
VITE_API_URL=/api

# Only used by the Vite dev/preview proxy
VITE_PROXY_TARGET=http://localhost:8000
